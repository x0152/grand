#!/usr/bin/env python3
"""Search a mailbox folder.

All criteria are optional and AND-combined. Non-ASCII queries are sent
with CHARSET UTF-8 so Cyrillic/CJK/etc. searches don't crash; if the
server refuses CHARSET on an ASCII-only query we transparently retry
without it.

Run `email-folders` first when in doubt about the folder name (Spam vs
Junk vs "Спам", etc.).
"""
import argparse
import sys

sys.path.insert(0, "/usr/local/libexec/email")
import email_helper as eh


def main():
    p = argparse.ArgumentParser(prog="email-search", description="Search the mailbox")
    p.add_argument("--folder", default="INBOX",
                   help="Folder to search. Aliases like Sent/Spam/Trash/Drafts work.")
    p.add_argument("--from", dest="from_addr", default=None)
    p.add_argument("--to", dest="to_addr", default=None)
    p.add_argument("--subject", default=None)
    p.add_argument("--text", default=None,
                   help="Substring that must appear anywhere in the message text.")
    p.add_argument("--since", default=None, help="YYYY-MM-DD (inclusive lower bound).")
    p.add_argument("--before", default=None, help="YYYY-MM-DD (exclusive upper bound).")
    p.add_argument("--unseen", action="store_true")
    p.add_argument("--seen", action="store_true")
    p.add_argument("--flagged", action="store_true")
    p.add_argument("--limit", type=int, default=20)
    p.add_argument("--json", action="store_true",
                   help="Emit JSON Lines (one message object per line).")
    args = p.parse_args()

    cfg = eh.load_config()
    if not eh.require_imap(cfg):
        return 0

    try:
        crit, charset = eh.imap_criteria(args)
    except Exception as e:
        return eh.die("email-search", e, exit_code=2)

    try:
        with eh.open_imap(cfg) as box:
            chosen = eh.set_folder(box, args.folder)
            messages = eh.fetch_messages(box, crit, charset=charset,
                                          limit=args.limit, headers_only=True)
    except eh.FolderNotFound as e:
        return eh.die("email-search", e, exit_code=2)
    except Exception as e:
        return eh.die("email-search", e)

    eh.print_messages(messages, folder=chosen, as_json=args.json,
                       empty_hint=f"(no matches in {chosen!r})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
