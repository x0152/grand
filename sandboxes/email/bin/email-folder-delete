#!/usr/bin/env python3
"""Delete an IMAP folder.

Examples:
  email-folder-delete --name Receipts                   # only allowed if empty
  email-folder-delete --name Receipts --yes-i-know      # delete even if non-empty

Hard-coded refusals (these are not opt-out-able):
  * INBOX is never deletable.
  * Any folder that resolves to a special-use one (Sent, Spam, Trash,
    Drafts, Archive) is never deletable — moving / removing those breaks
    every other mail client touching this account.

If you need to wipe one of those folders, mass-move its messages instead
(`email-list --folder Spam ...` followed by `email-move --to-folder Trash`).
"""
import argparse
import json
import sys

sys.path.insert(0, "/usr/local/libexec/email")
import email_helper as eh


def main():
    p = argparse.ArgumentParser(prog="email-folder-delete",
                                description="Delete an IMAP folder")
    p.add_argument("--name", required=True,
                   help="Folder name to delete (literal — aliases are not used).")
    p.add_argument("--yes-i-know", dest="yes", action="store_true",
                   help="Required when the folder still has messages.")
    p.add_argument("--json", action="store_true")
    args = p.parse_args()

    cfg = eh.load_config()
    if not eh.require_imap(cfg):
        return 0

    try:
        with eh.open_imap(cfg) as box:
            try:
                target = eh.find_folder(box, args.name, strict=True)
            except eh.FolderNotFound as e:
                return eh.die("email-folder-delete", e, exit_code=2)
            try:
                eh.assert_not_protected(box, target, op="delete")
            except PermissionError as e:
                return eh.die("email-folder-delete", e, exit_code=2)
            try:
                status = box.folder.status(target)
                msgs = int(status.get("MESSAGES", 0) or 0)
            except Exception:
                msgs = 0
            if msgs > 0 and not args.yes:
                return eh.die(
                    "email-folder-delete",
                    f"folder {target!r} contains {msgs} message(s); pass "
                    "--yes-i-know to delete anyway (messages will be lost).",
                    exit_code=2,
                )
            box.folder.delete(target)
    except Exception as e:
        return eh.die("email-folder-delete", e)

    if args.json:
        print(json.dumps({
            "name": target,
            "messages_lost": msgs,
        }, ensure_ascii=False))
    else:
        msg = f"deleted folder {target!r}"
        if msgs:
            msg += f" (along with {msgs} message(s))"
        print(msg)
    return 0


if __name__ == "__main__":
    sys.exit(main())
